// hk's own builtins, the extra builtins, and the hook templates from
// nnutter/hk-config. The hk-config version must target the hk pin in
// mise.toml, and the revision is the newest one released for that hk version.
amends
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-2/hk-config@2.11.1-2#/Config.pkl"

import
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-2/hk-config@2.11.1-2#/Builtins.pkl"
  as Extra
import
  "package://github.com/nnutter/hk-config/releases/download/v2.11.1-2/hk-config@2.11.1-2#/Hooks.pkl"
  as Hooks

/// Test fixtures hold deliberately invalid input for the tests that read them.
exclude = List("**/testdata/**")

// This repository develops constable, so every hook runs the working tree's
// build instead of the installed release.
// nilaway is part of constable now, and it reads every dependency unless it is
// told which module to analyze. Without the flag, a hook spends seconds and
// gigabytes on the standard library.
local const constableDev = (Extra.constable) {
  check = "go run ./cmd/constable -nilaway_config.include-pkgs=$(go list -m) ./..."
  fix = "go run ./cmd/constable -nilaway_config.include-pkgs=$(go list -m) -fix ./..."
}

// The templates build the check, fix, pre-commit, and commit-msg hooks, and
// they order the steps of each hook that fixes: the steps that rewrite files
// run in the order their edits must land, and every step that only reads waits
// for the last fixer, so the readers run together. `check` sets no order.
// `go`, `toml`, `yaml`, and `agentskills` are the groups this repository needs.
//
// A replaced step is a new step, so the template's order does not reach it: the
// go group runs constable after testifylint, and the replacement keeps that
// place in the hooks that fix.
hooks = (Hooks.all(List("go", "toml", "yaml", "agentskills"))) {
  ["check"] {
    steps {
      ["constable"] = constableDev
    }
  }
  ["fix"] {
    steps {
      ["constable"] = (constableDev) { depends = List("testifylint") }
    }
  }
  ["pre-commit"] {
    steps {
      ["constable"] = (constableDev) { depends = List("testifylint") }
    }
  }
}
